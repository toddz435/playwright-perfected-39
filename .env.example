# Copy to .env and fill in real values. .env is git-ignored — never commit secrets.

# Supabase (project URL + anon/publishable key). Both server and VITE_ vars are used.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Supabase SERVICE-ROLE (secret) key — admin client used ONLY by the scheduled-runs endpoint to
# read all users' schedules (bypasses RLS). The new-style "sb_secret_…" key from Settings → API.
# Server-side only; never expose to the client. Without it, scheduled runs can't function.
SUPABASE_SERVICE_ROLE_KEY=""

# Shared secret the scheduled-runs cron must send (header x-cron-secret) to trigger
# /api/public/run-due-schedules. The endpoint FAILS CLOSED if this is unset. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# Anthropic Claude — powers AI features (auto-heal, failure analysis, codegen, test gen).
# Create a key at https://console.anthropic.com (Settings → API Keys). Server-side only.
ANTHROPIC_API_KEY=""

# Encryption-at-rest key for secret variable values (AES-256-GCM). Server-side only.
# Must be 32 random bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: rotating it makes previously-encrypted secrets undecryptable.
SECRETS_KEY=""

# SSRF guard for user-supplied target URLs (the recorder's URL and API-test fetches). By
# default private/internal/loopback targets are refused (e.g. localhost, 169.254.169.254).
# Set to "true" ONLY on a trusted local machine where hitting your own localhost is intended.
# Leave unset/empty for shared/cloud runners.
ALLOW_PRIVATE_HOSTS=""
