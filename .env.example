# Copy to .env and fill in real values. .env is git-ignored — never commit secrets.

# Supabase (project URL + anon/publishable key). Both server and VITE_ vars are used.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Anthropic Claude — powers AI features (auto-heal, failure analysis, codegen, test gen).
# Create a key at https://console.anthropic.com (Settings → API Keys). Server-side only.
ANTHROPIC_API_KEY=""

# Encryption-at-rest key for secret variable values (AES-256-GCM). Server-side only.
# Must be 32 random bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: rotating it makes previously-encrypted secrets undecryptable.
SECRETS_KEY=""

# Recorder SSRF guard. By default the recorder refuses private/internal/loopback URLs
# (e.g. localhost, 169.254.169.254). Set to "true" ONLY on a trusted local machine where
# recording your own localhost app is intended. Leave unset/empty for shared/cloud runners.
RECORDER_ALLOW_PRIVATE_HOSTS=""
